generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  passwordHash String
  role         String        @default("MEMBER") // "ADMIN" or "MEMBER"
  createdAt    DateTime      @default(now())
  
  assignedLeads Lead[]       @relation("AssignedLeads")
  notes         Note[]
  activityLogs  ActivityLog[]
}

model Lead {
  id           Int           @id @default(autoincrement())
  name         String
  email        String
  phone        String?
  company      String?
  value        Float         @default(0)
  status       String        @default("NEW") // "NEW", "CONTACTED", "QUALIFIED", "PROPOSAL_SENT", "WON", "LOST"
  source       String        @default("Website Form")
  
  assignedToId Int?
  assignedTo   User?         @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  notes        Note[]
  activityLogs ActivityLog[]
}

model Note {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())

  leadId   Int
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  authorId Int
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  action    String   // e.g. "CREATED", "STATUS_CHANGE", "REASSIGNED", "NOTE_ADDED"
  details   String   // Human-readable description
  createdAt DateTime @default(now())

  leadId   Int
  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  actorId  Int?
  actor    User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
}
